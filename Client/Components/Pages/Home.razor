@page "/"
@namespace Client.Components.Pages
@rendermode InteractiveServer
@using BlazorBootstrap

<Toasts class="p-3" Messages="toastMessages" Placement="ToastsPlacement.BottomLeft" />

<div>
    <div class="chat-container">
        <div class="messages" style="background-color: @(Color ?? "transparent")">
            @foreach (var message in Messages)
            {
                <div class="message-row @(message.IsUser ? "user" : "bot")">
                    <div class="bubble">

                        @if (message.IsApprovalRequest)
                        {
                            @((MarkupString)RenderMarkdown(message.Text))

                            <div class="approval-buttons">
                                <button class="approve-btn"
                                        @onclick="() => HandleApproval(true)">
                                    Approve ✓
                                </button>

                                <button class="deny-btn"
                                        @onclick="() => HandleApproval(false)">
                                    Deny ✗
                                </button>
                            </div>
                        }
                        else
                        {
                            @((MarkupString)RenderMarkdown(message.Text))
                        }
                    </div>
                </div>
            }

        </div>

        <div class="input-bar">
    <div class="input-wrapper">
        <input 
               id="chatMessage"
               name="chatMessage"
               @bind="CurrentMessage"
               @bind:event="oninput"
               @onkeydown="HandleKeyDown"
               placeholder="@(awaitingApproval 
               ? "Please approve or deny the request above..." 
               : "Type a message...")"
               class="chat-input"
               disabled="@awaitingApproval" />

        <button class="send-btn"
                @onclick="SendMessage"
                disabled="@awaitingApproval">
            ➤
        </button>
    </div>
</div>
    </div>
</div>
